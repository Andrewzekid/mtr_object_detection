import cv2
from ultralytics.models.sam import SAM3VideoSemanticPredictor

# 1. Initialize the SAM3 Video Predictor
overrides = dict(
    conf=0.25, 
    task="segment", 
    mode="predict", 
    imgsz=640, 
    model="sam3_b.pt",  # Ensure you use the correct SAM3 weight file
    save=False
)
predictor = SAM3VideoSemanticPredictor(overrides=overrides)

# 2. Open the video source using OpenCV
video_path = "path/to/video.mp4"
cap = cv2.VideoCapture(video_path)

if not cap.isOpened():
    print("Error: Could not open video.")
    exit()

frame_idx = 0
while cap.isOpened():
    success, frame = cap.read()
    if not success:
        break  # End of video

    # 3. Define or fetch your frame-specific bounding boxes
    # Format: [x_min, y_min, x_max, y_max]
    # In a real scenario, these might come from a YOLO detection loop
    if frame_idx == 0:
        current_bboxes = [[864, 383, 975, 620], [705, 229, 782, 402]]
    else:
        # Simulate moving boxes for subsequent frames
        current_bboxes = [[864 + frame_idx, 383, 975 + frame_idx, 620]]

    # 4. Predict on the CURRENT frame with its specific boxes
    # We pass labels=[1] * len(current_bboxes) to mark them all as positive prompts
    results = predictor(
        source=frame,
        bboxes=current_bboxes,
        labels=[1] * len(current_bboxes),
        stream=False  # Processing single frame, stream=False is fine here
    )

    # 5. Process and visualize the results for the current frame
    for r in results:
        # r.show() will open a window per frame, or you can get the annotated image:
        annotated_frame = r.plot()
        
        # Display using OpenCV
        cv2.imshow("SAM3 Frame-by-Frame Tracking", annotated_frame)

    # Break the loop if 'q' is pressed
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

    frame_idx += 1

# Clean up
cap.release()
cv2.destroyAllWindows() 
